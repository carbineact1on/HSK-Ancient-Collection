<?xml version="1.0" encoding="utf-8"?>
<!-- Make all Ancient Mining Industry structures deconstructable-only -->
<Patch>
    <!-- Strip designationCategory from abstract parent (cascades to all 7 mining facilities) -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[@Name="BreadMoAM_MiningFacilities"]/designationCategory</xpath>
    </Operation>

    <!-- Strip from concrete defs that have their own designationCategory (Turret + rails) -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="BreadMoAM_Turret_ShotgunTurretN" or defName="BreadMoAM_Crosstie" or defName="BreadMoAM_Rail"]/designationCategory</xpath>
    </Operation>
</Patch>
