<?xml version="1.0" encoding="utf-8"?>
<!--
    Make all AUR equipment + items loot/enemy-drop only.

    Removes <recipeMaker> from:
      - AMGun (all weapons - rifles/pistols/SMGs/snipers/LMGs)
      - AM_ArmorMachineableBase / AM_ArmorHelmetMakeableBase /
        AM_CataphractHelmet (all armor + helmets)
      - 8 medical kits / stims (AI2A, Hemostatic, FirstAid, Salewa,
        Grizzly, Metalblood, Analgesic, CellRegen)
      - AM_EmptyBox

    Without recipeMaker, RimWorld doesn't auto-generate craft recipes -
    they disappear from all benches' Bills menus.

    Items still:
      - Spawn on enemies (PawnKindDef equipment / apparel / inventory)
      - Drop as loot from kills + raid carcasses + scenarios
      - Generate in trader stock + quest rewards
      - Function normally (weapons fire / armor protects / kits heal -
        those stats are independent of recipeMaker)
      - Get decomposed at Ancient Dismantling Workbench (separate
        RecipeDefs in Recipes_Production.xml - unaffected)

    Buildings + raw materials (AM_AramidCloth, AM_UHMWPEPlate, etc.) +
    custom components (AM_ComponentWeapon, etc.) + ammo recipes remain
    craftable - this patch only targets equipment + consumable kits.
-->
<Patch>
    <!-- Weapons (AMGun parent + all AM_* rifles/pistols/SMGs/snipers) -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[@Name="AMGun" or @ParentName="AMGun"]/recipeMaker</xpath>
    </Operation>

    <!-- Armor + helmets (3 abstract bases + their inheritance chain) -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[@Name="AM_ArmorMachineableBase" or @ParentName="AM_ArmorMachineableBase" or @Name="AM_ArmorHelmetMakeableBase" or @ParentName="AM_ArmorHelmetMakeableBase" or @Name="AM_CataphractHelmet" or @ParentName="AM_CataphractHelmet"]/recipeMaker</xpath>
    </Operation>

    <!-- Medical kits + stims + empty box (8 useable items + AM_EmptyBox) -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="AM_AI2A" or defName="AM_HemostaticAgent" or defName="AM_FirstAidKit" or defName="AM_Salewa" or defName="AM_Grizzly" or defName="AM_MetalbloodInjector" or defName="AM_AnalgesicRegenerationInjector" or defName="AM_CellRegenerationInjector" or defName="AM_EmptyBox"]/recipeMaker</xpath>
    </Operation>

    <!-- Ancient Dismantling Workbench + Small Fuel Generator: deconstructable only.
         Removes only designationCategory (keeps costList so deconstruction yields
         ~75% of materials when found in ruins). -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="AM_AncientDismantlingWorkbench" or defName="AM_SmallGenerator"]/designationCategory</xpath>
    </Operation>

    <!-- Electrical Box: full HSK industrial-tier tune (stats + costList + skill prereq) -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="AM_ElectricalBox"]/statBases</xpath>
        <value>
            <statBases>
                <MaxHitPoints>350</MaxHitPoints>
                <WorkToBuild>3000</WorkToBuild>
                <Flammability>1.0</Flammability>
                <Beauty>-20</Beauty>
                <Mass>220</Mass>
            </statBases>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="AM_ElectricalBox"]/costList</xpath>
        <value>
            <costList>
                <SteelBar>100</SteelBar>
                <ComponentIndustrial>3</ComponentIndustrial>
                <ElectronicComponents>4</ElectronicComponents>
                <Mechanism>1</Mechanism>
                <Microchips>2</Microchips>
                <Wire>10</Wire>
            </costList>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="AM_ElectricalBox"]</xpath>
        <value>
            <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
        </value>
    </Operation>
</Patch>
