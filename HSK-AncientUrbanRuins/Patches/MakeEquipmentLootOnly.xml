<?xml version="1.0" encoding="utf-8"?>
<!--
    Make all AUR weapons + clothing loot/enemy-drop only.

    Removes <recipeMaker> from the AMGun (weapons) and AM_ArmorMachineableBase
    / AM_ArmorHelmetMakeableBase / AM_CataphractHelmet (apparel) abstract
    parents and every concrete def that inherits from them. Without
    recipeMaker, RimWorld doesn't auto-generate craft recipes - they
    disappear from all benches' Bills menus.

    Items still:
      - Spawn on enemies (PawnKindDef equipment / apparel)
      - Drop as loot from kills + raid carcasses + scenarios
      - Generate in trader stock + quest rewards
      - Function normally (weapons fire / armor protects - those stats
        are independent of recipeMaker)
      - Get decomposed at Ancient Dismantling Workbench (separate
        RecipeDefs in Recipes_Production.xml - unaffected)

    Buildings + items + materials remain craftable as the mod author
    intended - this patch only targets equipment.
-->
<Patch>
    <!-- Weapons (AMGun parent + all AM_* rifles/pistols/SMGs/snipers) -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[@Name="AMGun" or @ParentName="AMGun"]/recipeMaker</xpath>
    </Operation>

    <!-- Armor + helmets (3 abstract bases + their inheritance chain) -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[@Name="AM_ArmorMachineableBase" or @ParentName="AM_ArmorMachineableBase" or @Name="AM_ArmorHelmetMakeableBase" or @ParentName="AM_ArmorHelmetMakeableBase" or @Name="AM_CataphractHelmet" or @ParentName="AM_CataphractHelmet"]/recipeMaker</xpath>
    </Operation>
</Patch>
